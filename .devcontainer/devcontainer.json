{
  "name": "mhc-atlas",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "pip install -e .[dev,app]",
  "forwardPorts": [8501],
  "remoteUser": "root"
}
